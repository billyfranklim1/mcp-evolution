EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=your-evolution-api-key

# Single instance…
EVOLUTION_INSTANCE=your-instance-name
# …or several (do not set both)
# EVOLUTION_INSTANCES=personal,support
# EVOLUTION_DEFAULT_INSTANCE=personal

# Optional guards
# EVOLUTION_ALLOWED_TOOLS=@read,@send
# EVOLUTION_ALLOWED_RECIPIENTS=5511999999999,123456789012345@lid
# EVOLUTION_ALLOWED_RECIPIENTS__SUPPORT=*

# Optional
# EVOLUTION_BASIC_AUTH=base64-of-user:password
# EVOLUTION_DB_URL=postgresql://user:pass@host:5432/evolution_api
